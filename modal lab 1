
<html>
<head>
<style>
.modal-bg {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  justify-content: center;
  align-items: center;
}
.modal-box {
  background: rgb(255, 255, 255);
  padding: 20px;
  width: 300px;
  text-align: center;
  border-radius: 10px;
  transform: scale(0.5);
  opacity: 0;
  transition: 0.3s;
}
.modal-bg.show .modal-box {
  transform: scale(1);
  opacity: 1;
}
button {
  padding: 8px 15px;
}
</style>
</head>

<body>
<button onclick="showModal()">Open Animated Modal</button>

<div class="modal-bg" id="modal">
  <div class="modal-box">
    <h3>Animated Modal</h3>
    <p>Cool Zoom effect!</p>
    <button onclick="hideModal()">Close</button>
  </div>
</div>

<script>
function showModal() {
  document.getElementById("modal").classList.add("show");
  document.getElementById("modal").style.display = "flex";
}
function hideModal() {
  document.getElementById("modal").classList.remove("show");
  document.getElementById("modal").style.display = "none";
}
</script>
</body>
</html>
