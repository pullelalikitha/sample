
<html>
<head>
<style>

.container {
  width: 80%;
  max-width: 600px; 
  margin: 20px auto; 
  padding: 20px;
  background-color: lightblue;
}


img {
  width: 100%; 
  height: auto; 
}


.box {
  width: 200px;
  height: 150px;
  background-color: coral;
  margin-top: 20px;
}
</style>
</head>

<body>

<div class="container">
  <h2>CSS Sizing Example</h2>
  <p>This container adjusts to screen size.</p>
  <img src="https://via.placeholder.com/600x300" alt="Sample Image">
</div>

<div class="box">
  Fixed Size Box
</div>

</body>
</html>
